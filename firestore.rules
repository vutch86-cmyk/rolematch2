rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function testEnvironmentEnabled() {
      return request.time < timestamp.date(2026, 9, 30);
    }

    match /users/{document=**} {
      allow read, write: if testEnvironmentEnabled();
    }

    match /analysis_records/{document=**} {
      allow read, write: if testEnvironmentEnabled();
    }

    match /audit_logs/{document=**} {
      allow read, write: if testEnvironmentEnabled();
    }

    match /uploaded_documents/{document=**} {
      allow read, write: if testEnvironmentEnabled();
    }

    match /recruiter_batches/{document=**} {
      allow read, write: if testEnvironmentEnabled();
    }

    match /system_settings/{document=**} {
      allow read, write: if testEnvironmentEnabled();
    }

    match /ai_usage/{document=**} {
      allow read, write: if testEnvironmentEnabled();
    }

    match /ai_reservations/{document=**} {
      allow read, write: if testEnvironmentEnabled();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
